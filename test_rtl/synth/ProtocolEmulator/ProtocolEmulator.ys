# Yosys synthesis script for ProtocolEmulator (Tang Console 60K - GW5A architecture)

# Read the Verilog source
read_verilog ProtocolEmulator.v

# Synthesize for Gowin Arora-V (Tang Console 60K: GW5AT-LV60PG484AC1/I0)
synth_gowin -family gw5a -top ProtocolEmulator -json ProtocolEmulator.json

# Clean up unused cells and wires
clean

# Write synthesized gate-level Verilog netlist
write_verilog ProtocolEmulator_synth.v

# Report resource utilization
stat