[tasks]
bound
prf
cvr

[options]
bound: mode bmc
bound: depth 20
prf:   mode prove
prf:   depth 10
cvr:   mode cover
cvr:   depth 25
cvr:   append 5

[engines]
bound: smtbmc
prf:   smtbmc yices
cvr:   smtbmc

[script]
read_verilog -sv -DPROTOCOLEMULATOR -formal template_formal.v
prep -top ProtocolEmulator

[files]
template_formal.v
