[tasks]
bound
prf
cvr

[options]
bound: mode bmc
bound: depth 10
prf:   mode prove
prf:   depth 10
cvr:   mode cover
cvr:   depth 15
cvr:   append 5

[engines]
bound: smtbmc
prf:   smtbmc yices
cvr:   smtbmc

[script]
read_verilog -sv -DOMNIBUS_WISHBONE -DFORMAL omnibus_fifo.v OmniBus_Profiler.v OmniBus_USB_SIE.v OmniBus_DMA.v ProtocolEmulator.v template_formal.v
prep -top OmniBus_Wishbone

[files]
omnibus_fifo.v
OmniBus_Profiler.v
OmniBus_USB_SIE.v
OmniBus_DMA.v
ProtocolEmulator.v
template_formal.v
